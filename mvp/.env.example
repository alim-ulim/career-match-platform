# Configure these in the hosting service's secret/variable settings.
# This file contains no usable password. Never commit real .env files.
NODE_ENV=production
HOST=0.0.0.0
PORT=8766
DATA_DIR=/data/ulim
# Replace with the exact issued HTTPS host before starting the service.
PUBLIC_ORIGIN=https://YOUR-HOST.example
# Set a unique 12+ character password in the host's secret settings.
ADMIN_PASSWORD=
